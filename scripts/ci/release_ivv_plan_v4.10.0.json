  "required_checks": [
    {
      "id": "candidate-ci",
      "binding": "publication",
      "requirement": "Exact publication CI/security results plus product CI provenance; no unresolved release blocker."
    },
    {
      "id": "native-signatures",
      "binding": "product",
      "requirement": "Revalidate all four signed packages and selected production trust roots against the frozen hashes."
    },
    {
      "id": "source-payload-continuity",
      "binding": "publication",
      "requirement": "Reviewed tooling-only source diff, frozen build inputs and unchanged signed package bytes; bind product and publication commits separately."
    },
    {
      "id": "changed-list-unit-regressions",
      "binding": "product",
      "requirement": "Positive and negative IPv4/IPv6 whitelist and shared blocklist cases, unsafe files, seeded entries, lost family after initialization and first reload."
    },
    {
      "id": "changed-activation-native",
      "binding": "product",
      "requirement": "Targeted activation, real expected SSH block, allowed operator access, reload and restart persistence on DEB-U2604, RPM-A9, RPM-A10, RPM-A9-RHELPO and APK-324. RPM-A10-RHELPO exact-product full PASS is retained."
    },
    {
      "id": "alpine-ssh-provenance",
      "binding": "product",
      "requirement": "Positive native Alpine authentication and negative untrusted lookalike envelopes, plus native APK-324 activation coverage."
    },
    {
      "id": "native-lifecycle-continuity",
      "binding": "historical-plus-fresh",
      "requirement": "Verify retained five-profile lifecycle evidence on its original commit; pair with changed-activation checks. No old verdict relabeling."
    },
    {
      "id": "node01-migrations",
      "binding": "product",
      "requirement": "Complete the two missing native migration paths and verify configuration, ownership, service activation, recovery and restoration."
    },
    {
      "id": "offline-update",
      "binding": "product",
      "requirement": "Complete independent native signed offline candidate update with exact package and installed CLI binding, refusal of substituted inputs and no network fallback."
    },
    {
      "id": "ha-functional",
      "binding": "historical-plus-fresh",
      "requirement": "Revalidate historical two 30-minute campaigns and signed statement; verify final-package peer bootstrap, replication, restart/recovery and allowlist preservation. Repeat endurance only for an affected mechanism or observed regression."
    },
    {
      "id": "feed-allocation-continuity",
      "binding": "historical-plus-fresh",
      "requirement": "Retain original feed/allocation measurements; verify unchanged mechanism and list integration. No new performance or full-qualification claim."
    },
    {
      "id": "restorations",
      "binding": "product",
      "requirement": "Verify all modified native hosts and their network protections after the final targeted tests."
    },
    {
      "id": "protected-ivv-acceptance",
      "binding": "publication",
      "requirement": "Protected producer, independent consumer revalidation, reviewed evidence admissions and no missing required check."
    },
    {
      "id": "release-authenticity",
      "binding": "publication",
      "requirement": "Signed annotated tag, exact immutable assets and update manifest, Sigstore subject and approved identity, followed by downloaded-asset verification."
    }
  ],
  "long_campaign_policy": "No automatic full endurance or broad performance replay. An affected mechanism, observed regression or published release claim requires a documented replay decision.",
  "claim_limits": [
    "Not full IVVQ qualification.",
    "No guarantee of absence of all defects.",
