    {
      "id": "extended_controls",
      "scenario_id": "native-extended-controls"
    }
  ],
  "native_controls": [
    {"id": "operator-policy-tcp-apply", "assertions": {"protocol": "tcp", "exact_nft_ruleset_verified": true}},
    {"id": "operator-policy-udp-apply", "assertions": {"protocol": "udp", "exact_nft_ruleset_verified": true}},
    {"id": "operator-policy-concurrent-mutation", "assertions": {"serialized": true, "lost_update": false}},
    {"id": "operator-policy-rollback-restart", "assertions": {"rollback_verified": true, "restart_verified": true}},
    {"id": "operator-policy-third-party-preservation", "assertions": {"third_party_rules_unchanged": true}},
    {"id": "hids-log-rotation", "assertions": {"events_preserved": true, "duplicates": 0}},
    {"id": "hids-log-truncation", "assertions": {"events_preserved": true, "duplicates": 0}},
    {"id": "hids-log-replacement", "assertions": {"replacement_attested": true, "events_preserved": true}},
    {"id": "hids-delayed-write", "assertions": {"delayed_event_observed": true, "duplicates": 0}},
    {"id": "hids-unsafe-path-refusal", "assertions": {"symlink_refused": true, "special_file_refused": true, "wrong_owner_refused": true, "wrong_mode_refused": true}},
    {"id": "hips-bf-slow", "assertions": {"real_network_attempts": true, "admitted_hits_match": true, "jail_match": true}},
    {"id": "waap-exploit-severity", "assertions": {"signature_catalog_bound": true, "severity_match": true}},
    {"id": "waap-deduplication", "assertions": {"duplicate_events_suppressed": true, "physical_hits_preserved": true}},
    {"id": "waap-backpressure", "assertions": {"queue_bounded": true, "degraded_evidence_reported": true}},
    {"id": "waap-non-recursion", "assertions": {"recursive_alerts": 0}}
  ],
  "package_owned_controls": [
    {"id": "rhelpo-go-runtime-only", "assertions": {"go_runtime_scope": "runtime-only", "system_configuration_mutations": false}},
    {"id": "rhelpo-package-owned-system-state", "assertions": {"configuration_owned_by_package": true, "firewall_owned_by_package": true, "systemd_units_owned_by_package": true}},
    {"id": "rhelpo-first-boot-after-chroot", "assertions": {"installation_context": "rhel9-image-chroot", "first_boot_verified": true}}
  ],
  "attack_scenarios": [
    {
      "id": "hips-native-ssh-bruteforce",
      "capability": "hips",
      "rule_id": "ssh-auth",
      "risk_category": "brute_force",
      "observation_origin": "real-controlled-network-attempts",
