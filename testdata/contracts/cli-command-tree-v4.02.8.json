  {
    "path": "syswarden completion bash",
    "use": "bash",
    "short": "Generate the autocompletion script for bash",
    "long": "Generate the autocompletion script for the bash shell.\n\nThis script depends on the 'bash-completion' package.\nIf it is not installed already, you can install it via your OS's package manager.\n\nTo load completions in your current shell session:\n\n\tsource \u003c(syswarden completion bash)\n\nTo load completions for every new session, execute once:\n\n#### Linux:\n\n\tsyswarden completion bash \u003e /etc/bash_completion.d/syswarden\n\n#### macOS:\n\n\tsyswarden completion bash \u003e $(brew --prefix)/etc/bash_completion.d/syswarden\n\nYou will need to start a new shell for this setup to take effect.\n",
    "flags": [
      {
        "name": "config",
        "type": "string",
        "default": "/opt/syswarden/syswarden-auto.conf",
        "usage": "config file",
        "persistent": true
      },
      {
        "name": "help",
        "shorthand": "h",
        "type": "bool",
        "default": "false",
        "no_option": "true",
        "usage": "help for bash"
      }
