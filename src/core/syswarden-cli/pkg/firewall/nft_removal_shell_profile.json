  "literals": {
    "front": "table inet syswarden_table {\n    # 3. FRONTLINE CHAIN (Executes BEFORE Fail2ban at priority -10)\n    chain input_frontline {\n        type filter hook input priority filter - 10; policy accept;\n        ct state established,related accept\n",
    "backend": "    }\n\n    # 4. BACKEND CHAIN (Executes AFTER Fail2ban at priority 10)\n    # Serves as the Zero-Trust Catch-All, allowing legitimate traffic first.\n    chain input_backend {\n        type filter hook input priority filter + 10; policy drop;\n        # 1. Silently drop invalid packets (broken TCP states)\n        ct state invalid drop\n        # 2. Silently drop TCP connection noise (late FIN-ACK/RST on expired conntrack)\n        # Mimics UFW: Only genuine NEW SYN packets are permitted to reach the Catch-All\n        tcp flags & (fin|syn|rst|ack) != syn ct state new drop\n        # 3. Allow established flows\n        ct state established,related accept\n        iifname \"lo\" accept\n        ip protocol icmp accept\n        meta l4proto ipv6-icmp accept\n",
    "tail": "        # The Catch-All Drop: Any packet surviving Frontline and Fail2ban hits this.\n        limit rate 2/second log prefix \"[SysWarden-BLOCK] [Catch-All] \"\n        drop\n    }\n}\n",
    "whitelist6": "        ip6 saddr $wl_ip accept\n",
    "whitelist4": "        ip saddr $wl_ip accept\n",
    "wg_port": "        udp dport ${WG_PORT:-51820} accept\n",
    "wg_front": "        iifname { \"wg0\", \"lo\" } accept comment \"SysWarden: Global Trust for VPN\"\n",
    "ssh_drop": "        tcp dport ${SSH_PORT:-22} log prefix \"[SysWarden-SSH-DROP] \" drop\n",
    "active_ports": "        tcp dport { ${SSH_PORT:-22}, $ACTIVE_PORTS } accept\n",
    "quic": "        udp dport 443 accept comment \"SysWarden: QUIC / HTTP3 Support\"\n",
    "ssh_only": "        tcp dport { ${SSH_PORT:-22} } accept\n",
    "wg_backend": "        iifname { \"wg0\", \"lo\" } accept\n"
  },
  "program": [
    {
      "literal": "front"
    },
    {
      "whitelist": true
    },
    {
      "if": "WireGuard",
      "then": [
        {
          "literal": "wg_port"
        },
        {
          "literal": "wg_front"
        },
        {
          "literal": "ssh_drop"
        }
      ]
    },
    {
      "literal": "backend"
    },
    {
      "if": "ActivePorts",
      "then": [
        {
          "literal": "active_ports"
        },
        {
          "if": "QUIC",
          "then": [
            {
              "literal": "quic"
            }
          ]
        }
      ],
      "else": [
        {
          "literal": "ssh_only"
        }
      ]
    },
    {
      "if": "WireGuard",
      "then": [
        {
          "literal": "wg_port"
        },
        {
          "literal": "wg_backend"
        }
      ]
    },
    {
      "literal": "tail"
    }
