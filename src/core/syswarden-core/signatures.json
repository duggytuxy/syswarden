{
  "rules": [
    {
      "id": "ssh-auth",
      "type": "regex",
      "pattern": "^(?:[A-Z][a-z]{2}[[:space:]]+[0-9]{1,2}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]+[^[:space:]]+[[:space:]]+)?sshd(?:\\[[0-9]+\\])?:[[:space:]]+(?:Failed password for|Invalid user|POSSIBLE BREAK-IN).*?from <HOST>(?: port [0-9]+(?: ssh[0-9]+)?)?(?: \\[preauth\\])?[[:space:]]*$",
      "service": "sshd",
      "action": "track",
      "trusted_host_capture": true
    },
    {
      "id": "drupal-login",
      "type": "aho-corasick",
      "patterns": [
        "POST /user/login",
        "?q=user/login"
      ],
      "service": "http",
      "action": "track"
    },
    {
      "id": "nextcloud-login",
      "type": "regex",
      "pattern": "Login failed: .*? \\(Remote IP: '<HOST>'\\)",
      "service": "nextcloud",
      "action": "track"
    },
    {
      "id": "zabbix-login",
      "type": "regex",
      "pattern": "^(?:(?:[A-Z][a-z]{2}[[:space:]]+[0-9]{1,2}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]+[^[:space:]]+[[:space:]]+)?zabbix_server(?:\\[[0-9]+\\])?:[[:space:]]+)?failed login of user .* from <HOST>[[:space:]]*$",
      "service": "zabbix",
      "action": "track",
      "trusted_host_capture": true
    },
    {
      "id": "haproxy-abuse",
      "type": "regex",
      "pattern": "<HOST>:\\d+ .*?(?:400|403|404|429)",
      "service": "haproxy",
      "action": "track"
    },
    {
      "id": "wireguard-handshake",
      "type": "regex",
      "pattern": "^(?:(?:[A-Z][a-z]{2}[[:space:]]+[0-9]{1,2}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]+[^[:space:]]+[[:space:]]+)?kernel(?:\\[[0-9]+\\])?:[[:space:]]+)?wireguard: .* Handshake for peer .* \\(<HOST>:[0-9]+\\) did not complete[[:space:]]*$",
      "service": "wireguard",
      "trusted_host_capture": true
    },
    {
      "id": "phpmyadmin",
      "type": "aho-corasick",
      "patterns": [
        "phpmyadmin"
      ],
      "service": "http"
    },
    {
      "id": "grafana-login",
      "type": "regex",
      "pattern": "(?:msg=\"Invalid username or password\"|status=401).*remote_addr=<HOST>",
      "service": "grafana",
      "action": "track"
    },
    {
      "id": "squid-denied",
      "type": "regex",
      "pattern": "<HOST> .*(?:TCP_DENIED|ERR_ACCESS_DENIED)",
      "service": "squid",
      "action": "track"
    },
    {
      "id": "dovecot-auth",
      "type": "regex",
      "pattern": "^(?:[A-Z][a-z]{2}[[:space:]]+[0-9]{1,2}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]+[^[:space:]]+[[:space:]]+)?dovecot(?:\\[[0-9]+\\])?:[[:space:]]+.*(?:Authentication failure|Aborted login|auth failed).*rip=<HOST>,[[:space:]]*lip=",
      "service": "dovecot",
      "action": "track",
      "trusted_host_capture": true
    },
    {
      "id": "proxmox-auth",
      "type": "regex",
      "pattern": "^(?:[A-Z][a-z]{2}[[:space:]]+[0-9]{1,2}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]+[^[:space:]]+[[:space:]]+)?pvedaemon\\[[0-9]+\\]:[[:space:]]+authentication failure;[[:space:]]+rhost=<HOST>(?:[[:space:]].*)?$",
      "service": "proxmox",
      "action": "track",
      "trusted_host_capture": true
    },
    {
      "id": "openvpn-tls",
      "type": "regex",
      "pattern": "^(?:(?:[A-Z][a-z]{2}[[:space:]]+[0-9]{1,2}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]+[^[:space:]]+[[:space:]]+)?openvpn(?:\\[[0-9]+\\])?:[[:space:]]+)?<HOST>:[0-9]+[[:space:]]+(?:TLS Error: TLS handshake failed|VERIFY ERROR:|TLS Auth Error:).*$",
      "service": "openvpn",
      "trusted_host_capture": true
    },
    {
      "id": "gitea-auth",
      "type": "regex",
      "pattern": "^(?:(?:[A-Z][a-z]{2}[[:space:]]+[0-9]{1,2}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]+[^[:space:]]+[[:space:]]+)?gitea(?:\\[[0-9]+\\])?:[[:space:]]+)?Failed authentication attempt for .* from <HOST>[[:space:]]*$",
      "service": "gitea",
      "action": "track",
      "trusted_host_capture": true
    },
    {
      "id": "cockpit-auth",
      "type": "regex",
      "pattern": "^(?:(?:[A-Z][a-z]{2}[[:space:]]+[0-9]{1,2}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]+[^[:space:]]+[[:space:]]+)?cockpit-ws(?:\\[[0-9]+\\])?:[[:space:]]+)?cockpit:auth\\): authentication failure;.*[[:space:]]rhost=(?:::ffff:)?<HOST>[[:space:]]*$",
      "service": "cockpit",
      "action": "track",
      "trusted_host_capture": true
    },
    {
      "id": "privesc",
      "type": "regex",
      "pattern": "^(?:[A-Z][a-z]{2}[[:space:]]+[0-9]{1,2}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]+[^[:space:]]+[[:space:]]+)?(?:su|sudo)(?:\\[[0-9]+\\])?:[[:space:]]+pam_unix\\((?:su|sudo):auth\\): authentication failure;.*rhost=<HOST>[[:space:]]+user=",
      "service": "auth",
      "action": "track",
      "trusted_host_capture": true
    },
    {
      "id": "jenkins-auth",
      "type": "regex",
      "pattern": "^(?:(?:[A-Z][a-z]{2}[[:space:]]+[0-9]{1,2}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]+[^[:space:]]+[[:space:]]+)?jenkins(?:\\[[0-9]+\\])?:[[:space:]]+)?(?:unsuccessfulAuthentication|Login attempt failed).*[[:space:]]from <HOST>[[:space:]]*$",
      "service": "jenkins",
      "action": "track",
      "trusted_host_capture": true
    },
    {
      "id": "gitlab-auth",
      "type": "regex",
      "pattern": "^(?:(?:[A-Z][a-z]{2}[[:space:]]+[0-9]{1,2}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]+[^[:space:]]+[[:space:]]+)?gitlab(?:\\[[0-9]+\\])?:[[:space:]]+)?(?:Failed Login|Authentication failed).*[[:space:]](?:ip|IP)=<HOST>[[:space:]]*$",
      "service": "gitlab",
      "action": "track",
      "trusted_host_capture": true
    },
    {
      "id": "redis-auth",
      "type": "regex",
      "pattern": "<HOST>:\\d+ .*?[Aa]uthentication failed",
      "service": "redis",
      "action": "track"
    },
    {
      "id": "rabbitmq-auth",
      "type": "regex",
      "pattern": "^(?:(?:[A-Z][a-z]{2}[[:space:]]+[0-9]{1,2}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]+[^[:space:]]+[[:space:]]+)?rabbitmq(?:\\[[0-9]+\\])?:[[:space:]]+)?HTTP access denied: .* from <HOST>[[:space:]]*$",
      "service": "rabbitmq",
      "action": "track",
      "trusted_host_capture": true
    },
    {
      "id": "ha-cluster",
      "type": "regex",
      "pattern": "\\[SysWarden-BLOCK\\] \\[HA-Cluster\\] SRC=<HOST>",
      "service": "kernel"
    },
    {
      "id": "auditd",
      "type": "regex",
      "pattern": "type=(?:USER_LOGIN|USER_AUTH|USER_ERR|USER_CMD).*addr=(?:::f{4}:)?<HOST>.*res=(?:failed|0)",
      "service": "auditd"
    },
    {
      "id": "revshell",
      "type": "aho-corasick",
      "patterns": [
        "/bin/bash",
        "/bin/sh",
        "nc -e",
        "socat",
        "wget -q",
        "curl -s"
      ],
      "service": "http"
    },
    {
      "id": "aibots",
      "type": "aho-corasick",
      "patterns": [
        "GPTBot",
        "ChatGPT-User",
        "ClaudeBot",
        "Anthropic-ai"
      ],
      "service": "http"
    },
    {
      "id": "badbots",
      "type": "aho-corasick",
      "patterns": [
        "Nuclei",
        "sqlmap",
        "Nikto",
        "ZmEu",
        "OpenVAS",
        "wpscan",
        "masscan",
        "zgrab"
      ],
      "service": "http"
    },
    {
      "id": "modsec",
      "type": "regex",
      "pattern": "ModSecurity: Access denied with code [45]\\d\\d.*?\\[client <HOST>",
      "service": "modsec"
    },
    {
      "id": "webshell",
      "type": "aho-corasick",
      "patterns": [
        "wso.php",
        "c99.php",
        "r57.php",
        "b374k.php",
        "shell.php",
        "cmd.jsp",
        "cmd.exe"
      ],
      "service": "http"
    },
    {
      "id": "sqli",
      "type": "aho-corasick",
      "patterns": [
        "UNION SELECT",
        "UNION ALL SELECT",
        "CONCAT(",
        "WAITFOR DELAY",
        "pg_sleep(",
        "SLEEP(",
        "eval(",
        "base64_decode(",
        "DROP TABLE",
        "SELECT * FROM"
      ],
      "service": "http"
    },
    {
      "id": "secretshunter",
      "type": "aho-corasick",
      "patterns": [
        ".env",
        ".git",
        "id_rsa",
        "id_ed25519",
        "docker-compose.yml",
        "wp-config.php.bak"
      ],
      "service": "http"
    },
    {
      "id": "ssrf",
      "type": "aho-corasick",
      "patterns": [
        "169.254.169.254",
        "metadata/instance",
        "metadata.google.internal",
        "100.100.100.200"
      ],
      "service": "http"
    },
    {
      "id": "jndi-ssti",
      "type": "aho-corasick",
      "patterns": [
        "${jndi:",
        "class.module.classLoader",
        "${spring.macro"
      ],
      "service": "http"
    },
    {
      "id": "lfi-advanced",
      "type": "aho-corasick",
      "patterns": [
        "php://filter",
        "php://input",
        "file://",
        "zip://",
        "phar://",
        "/etc/passwd",
        "/etc/shadow",
        "/windows/win.ini",
        "/windows/system32"
      ],
      "service": "http"
    },
    {
      "id": "apimapper",
      "type": "aho-corasick",
      "patterns": [
        "/swagger-ui",
        "/openapi.json",
        "/swagger.json",
        "/api-docs",
        "/graphiql"
      ],
      "service": "http"
    },
    {
      "id": "vaultwarden",
      "type": "regex",
      "pattern": "^(?:(?:[A-Z][a-z]{2}[[:space:]]+[0-9]{1,2}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]+[^[:space:]]+[[:space:]]+)?vaultwarden(?:\\[[0-9]+\\])?:[[:space:]]+)?Invalid password.*from <HOST>[[:space:]]*$",
      "service": "vaultwarden",
      "action": "track",
      "trusted_host_capture": true
    },
    {
      "id": "idor-enum",
      "type": "aho-corasick",
      "patterns": [
        "/api/v1/users/",
        "/api/v1/profile/",
        "/api/v1/orders/"
      ],
      "service": "http",
      "action": "track",
      "threshold": 15,
      "window": 60
    },
    {
      "id": "sso",
      "type": "regex",
      "pattern": "msg=\"Authentication failed\".*remote_ip=\"<HOST>\"",
      "service": "sso",
      "action": "track"
    },
    {
      "id": "cms-wordpress",
      "type": "aho-corasick",
      "patterns": [
        "/wp-includes",
        "/wp-admin",
        "/wp-login.php",
        "xmlrpc.php",
        "wp-config.php",
        "/wp-json/batch/v1",
        "rest_route=/batch/v1"
      ],
      "service": "http"
    },
    {
      "id": "cms-joomla",
      "type": "aho-corasick",
      "patterns": [
        "/joomla",
        "/administrator/index.php",
        "Joomla!"
      ],
      "service": "http"
    },
    {
      "id": "cms-magento",
      "type": "aho-corasick",
      "patterns": [
        "/magento",
        "/downloader/index.php"
      ],
      "service": "http"
    },
    {
      "id": "proxy-abuse",
      "type": "aho-corasick",
      "patterns": [
        "CONNECT ",
        "TRACE ",
        "TRACK "
      ],
      "service": "http"
    },
    {
      "id": "telnet",
      "type": "regex",
      "pattern": "telnetd(?:\\[\\d+\\])?: connect from (?:::f{4}:)?<HOST>",
      "service": "telnet"
    },
    {
      "id": "odoo",
      "type": "regex",
      "pattern": "^(?:(?:[A-Z][a-z]{2}[[:space:]]+[0-9]{1,2}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]+[^[:space:]]+[[:space:]]+)?odoo(?:\\[[0-9]+\\])?:[[:space:]]+)?Login failed for db:.* login:.* from <HOST>[[:space:]]*$",
      "service": "odoo",
      "action": "track",
      "trusted_host_capture": true
    },
    {
      "id": "prestashop",
      "type": "regex",
      "pattern": "controller=AdminLogin.*?200",
      "service": "http",
      "action": "track"
    },
    {
      "id": "atlassian",
      "type": "regex",
      "pattern": "POST .*?(?:/login\\.jsp|/dologin\\.action|/rest/auth).*?(?:401|403|200)",
      "service": "http",
      "action": "track"
    },
    {
      "id": "dolibarr",
      "type": "regex",
      "pattern": "POST .*?(?:/htdocs/index\\.php|/api/index\\.php/login).*?(?:401|403|200)",
      "service": "http",
      "action": "track"
    },
    {
      "id": "nginx-tls",
      "type": "regex",
      "pattern": "^[0-9]{4}/[0-9]{2}/[0-9]{2}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}[[:space:]]+\\[[a-z]+\\](?:[[:space:]]+[0-9]+#[0-9]+:[[:space:]]+(?:\\*[0-9]+[[:space:]]+)?)?[[:space:]]*SSL_do_handshake\\(\\) failed.*?while SSL handshaking, client: <HOST>,[[:space:]]+server:",
      "service": "nginx",
      "trusted_host_capture": true
    },
    {
      "id": "apache-tls",
      "type": "regex",
      "pattern": "\\[client <HOST>(?::\\d+)?\\] AH\\d+: .*?(?:certificate verify failed|SSL Library Error|handshake failed)",
      "service": "apache"
    },
    {
      "id": "apache-scanner",
      "type": "regex",
      "pattern": "\\[client <HOST>(?::\\d+)?\\] (?:AH00128: File does not exist|AH01264: script not found or unable to stat|AH02033: script not found|AH01071: Got error)",
      "service": "apache",
      "action": "track"
    },
    {
      "id": "apache-auth",
      "type": "regex",
      "pattern": "\\[client <HOST>(?::\\d+)?\\] (?:AH01617: user .*? authentication failure|AH01618: user .*? not found|AH01796: AuthType .*? password mismatch|AH01807: user .*? authorization failure)",
      "service": "apache",
      "action": "track"
    },
    {
      "id": "apache-nohome",
      "type": "regex",
      "pattern": "\\[client <HOST>(?::\\d+)?\\] AH01630: client denied by server configuration",
      "service": "apache"
    },
    {
      "id": "apache-overflows",
      "type": "regex",
      "pattern": "\\[client <HOST>(?::\\d+)?\\] AH00565: request failed: (?:URI too long|error reading the headers)",
      "service": "apache"
    },
    {
      "id": "slowloris",
      "type": "regex",
      "pattern": "client timed out \\(\\d+: [^)]+\\) while reading client request.*, client: <HOST>",
      "service": "http"
    },
    {
      "id": "docker-api",
      "type": "aho-corasick",
      "patterns": [
        "/v1.24/containers/create",
        "/v1.41/containers/create",
        "/var/run/docker.sock"
      ],
      "service": "docker"
    },
    {
      "id": "docker-auth",
      "type": "regex",
      "pattern": "Failed to authenticate.*remote_ip=\"<HOST>\"",
      "service": "docker",
      "action": "track"
    },
    {
      "id": "cve-ivanti",
      "type": "aho-corasick",
      "patterns": [
        "/api/v1/totp",
        "/api/v1/cav/client/status"
      ],
      "service": "http"
    },
    {
      "id": "cve-confluence",
      "type": "aho-corasick",
      "patterns": [
        "/server-info.action",
        "/setup/setupadministrator.action"
      ],
      "service": "http"
    },
    {
      "id": "deserialization",
      "type": "aho-corasick",
      "patterns": [
        "O:8:\"stdClass\":",
        "rO0AB",
        "ysoserial"
      ],
      "service": "http"
    },
    {
      "id": "modern-crawlers",
      "type": "aho-corasick",
      "patterns": [
        "PerplexityBot",
        "OAI-SearchBot",
        "ClaudeBot",
        "Amazonbot"
      ],
      "service": "http"
    },
    {
      "id": "advanced-fuzzers",
      "type": "aho-corasick",
      "patterns": [
        "ffuf",
        "kiterunner",
        "dirb",
        "gobuster"
      ],
      "service": "http"
    },
    {
      "id": "mitre-t1595-active-scan",
      "type": "regex",
      "pattern": "(?:Nmap|ZGrab|Masscan|CensysInspect|Shodan)",
      "service": "http",
      "action": "detect"
    },
    {
      "id": "mitre-t1059-cmd-exec",
      "type": "aho-corasick",
      "patterns": [
        "powershell -enc",
        "cmd.exe /c",
        "WScript.Shell",
        "Invoke-Expression"
      ],
      "service": "http",
      "action": "detect"
    },
    {
      "id": "mitre-t1190-exploit-public",
      "type": "aho-corasick",
      "patterns": [
        "/cgi-bin/",
        "jndi:ldap",
        "log4j"
      ],
      "service": "http",
      "action": "detect"
    },
    {
      "id": "owasp-a03-injection",
      "type": "aho-corasick",
      "patterns": [
        "1=1--",
        "' OR '1'='1",
        "DROP TABLE",
        "UNION ALL SELECT"
      ],
      "service": "http",
      "action": "detect"
    },
    {
      "id": "owasp-a03-xss",
      "type": "aho-corasick",
      "patterns": [
        "<script>alert",
        "javascript:alert",
        "javascript:",
        "onerror=",
        "onload=",
        "svg/onload",
        "onmouseover="
      ],
      "service": "http",
      "action": "detect"
    },
    {
      "id": "cve-teamcity",
      "type": "aho-corasick",
      "patterns": [
        "/app/rest/server",
        "?jsp="
      ],
      "service": "http"
    },
    {
      "id": "cve-citrix-bleed",
      "type": "aho-corasick",
      "patterns": [
        "/oauth/idp/.well-known/openid-configuration"
      ],
      "service": "http"
    },
    {
      "id": "cve-moveit",
      "type": "aho-corasick",
      "patterns": [
        "guestaccess.aspx",
        "moveitisapi"
      ],
      "service": "http"
    },
    {
      "id": "cve-f5-bigip",
      "type": "aho-corasick",
      "patterns": [
        "Connection: X-F5-Auth-Token",
        "X-F5-Auth-Token"
      ],
      "service": "http"
    },
    {
      "id": "cloud-ssrf-metadata",
      "type": "aho-corasick",
      "patterns": [
        "Metadata-Flavor: Google",
        "169.254.169.254/latest/meta-data/",
        "169.254.169.254/metadata/v1/"
      ],
      "service": "http"
    },
    {
      "id": "java-ssti-rce",
      "type": "aho-corasick",
      "patterns": [
        "getRuntime().exec",
        "freemarker.template",
        "ProcessBuilder",
        "java.lang.Runtime"
      ],
      "service": "http",
      "action": "detect"
    },
    {
      "id": "php-rce-generic",
      "type": "aho-corasick",
      "patterns": [
        "system(",
        "passthru(",
        "shell_exec(",
        "base64_decode(",
        "phpinfo()"
      ],
      "service": "http",
      "action": "detect"
    },
    {
      "id": "generic-auth",
      "type": "regex",
      "pattern": "POST .*?(?:/login|/sign-in|/auth).*?(?:200|401|403)",
      "service": "http",
      "action": "track"
    },
    {
      "id": "laravel-login",
      "type": "regex",
      "pattern": "(?:Failed login|Authentication failed|Login failed).*<HOST>",
      "service": "laravel",
      "action": "track"
    },
    {
      "id": "nginx-scanner",
      "type": "regex",
      "pattern": "^(?:GET|POST|PUT|DELETE|HEAD|OPTIONS|CONNECT|TRACE) .*? (?:30[1278]|400|401|403|404|405|444)\\b",
      "service": "nginx",
      "action": "track"
    },
    {
      "id": "syswarden-l4-protect",
      "type": "regex",
      "pattern": "\\[CATCH-ALL\\] .*? SRC=<HOST> .*? PROTO=TCP .*? DPT=62026\\b",
      "service": "kernel",
      "action": "track",
      "threshold": 3,
      "window": 60
    },
    {
      "id": "syswarden-l7-protect",
      "type": "aho-corasick",
      "patterns": [
        "/ha/sync",
        "/ha/telemetry",
        "/ha/status",
        "/?token="
      ],
      "service": "http",
      "action": "track",
      "threshold": 3,
      "window": 60
    },
    {
      "id": "anssi-methods",
      "type": "regex",
      "pattern": "^(?:TRACE|TRACK|CONNECT) .*? (?:30[1278]|400|401|403|404|405|444)\\b",
      "service": "http",
      "action": "track",
      "threshold": 2,
      "window": 60
    },
    {
      "id": "anssi-path-traversal",
      "type": "aho-corasick",
      "patterns": [
        "../",
        "..\\",
        "/etc/passwd",
        "boot.ini",
        "windows/win.ini",
        "etc/shadow"
      ],
      "service": "http",
      "action": "detect"
    },
    {
      "id": "anssi-sensitive-files",
      "type": "aho-corasick",
      "patterns": [
        ".env",
        ".git/config",
        "wp-config.php.bak",
        "phpinfo.php",
        "docker-compose.yml"
      ],
      "service": "http",
      "action": "detect"
    }
  ]
}
